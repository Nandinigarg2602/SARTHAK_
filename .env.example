# ============================================
# SARTHAK — Environment Variables Template
# Copy this file to .env and fill in values
# ============================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/sarthak?retryWrites=true&w=majority

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio (SMS & Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Authentication
JWT_SECRET=your_jwt_secret_minimum_32_chars_long
JWT_EXPIRY=7d

# Emergency Link
EMERGENCY_LINK_BASE_URL=http://localhost:5173/emergency

# Demo Mode (set to 'true' to use mock API responses)
DEMO_MODE=true

# ---------- Client (Vite prefix: VITE_) ----------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GEMINI_API_KEY=your_gemini_api_key_here
